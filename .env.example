# The app itself needs no server-side configuration.
#
# Verity is bring-your-own-key: the user's OpenAI key is entered in the browser,
# held in their own local storage, and sent with each request. Nothing is stored
# server-side, so there is no database and no session secret.

# Used only by the live test suite (LIVE=1), never by the running app.
OPENAI_API_KEY=""

# Optional, and also user-supplied in the browser. Mistral Document AI is what
# reports where a passage sits on the page, so a highlight can be drawn on it.
MISTRAL_API_KEY=""
